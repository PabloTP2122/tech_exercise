# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# uv virtual environment
# (uv auto-excludes this internally, but it is best practice to keep it here)
.venv/

# Ruff linter cache
.ruff_cache/

# Environment variables and secrets
.env
.env.backend

#langgraph cache
#Langgraph studio
.langgraph_api
*.pckl
.langgraph_api/*.pckl

# Vector store
chroma_db/

# Tool caches
.mypy_cache/
.pytest_cache/

# Data / build artefacts
data/
frontend/node_modules/
frontend/dist/
!frontend/lib/

#Claude
.claude
# Spec dir is local-only — never commit anything under spec/
spec/**
